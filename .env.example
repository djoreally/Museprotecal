# Copy to .env and fill in. Never commit .env.
AGENTMAIL_API_KEY=am_your_key_here

# Phone provisioning (AgentPhone). Leave blank to run email-only.
AGENTPHONE_API_KEY=
# Public base URL of this server, so AgentPhone can reach /v1/webhooks/agentphone
WEBHOOK_BASE=https://your-server.com

PORT=8000

# Meta Model API (server-side only; rotate any previously shared keys)
MODEL_API_KEY=
META_MODEL=muse-wonder-1.0
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_EFFORT=high
