# Copy to .env and fill in. Never commit .env.
AGENTMAIL_API_KEY=am_your_key_here

# Phone provisioning (Twilio). Leave blank to run email-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL of this server, so Twilio can reach /v1/webhooks/sms
WEBHOOK_BASE=https://your-server.com

PORT=8000
